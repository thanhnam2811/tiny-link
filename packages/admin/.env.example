# Backend Integration
# INTERNAL_API_URL: Private base URL for the Fastify server (used for server-side calls)
INTERNAL_API_URL=http://localhost:3001
INTERNAL_API_KEY=__CHANGE_ME__

# Public base URL of the client app, used to build shareable short-link URLs
# in the admin links table. Falls back to window.location.origin if unset.
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
