generator client {
  provider = "prisma-client"
  output   = "../src/generated-client"
}

datasource db {
  provider = "postgresql"
}

model Link {
  id           String    @id @default(uuid())
  originalUrl  String
  shortCode    String    @unique
  redirectType Int       @default(302) // 301 or 302
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  maxClicks       Int?
  passwordHash    String?
  isActive        Boolean   @default(true)
  clicksCount     Int       @default(0)
  
  metaTitle       String?
  metaDescription String?
  metaImage       String?

  // Relations
  userId          String?
  guestId         String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  clicks          Click[]

  @@index([userId])    // Optimize dashboard queries
  @@index([guestId])   // Optimize claiming logic
}

model Click {
  id         String   @id @default(uuid())
  linkId     String
  link       Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  ipAddress  String?
  userAgent  String?
  country    String?
  city       String?
  clickedAt  DateTime @default(now())

  @@index([linkId, clickedAt]) // Optimize stats queries
  @@index([clickedAt]) // Optimize timeline/aggregate queries not scoped to a single link
}

// ---------------------------------------------------------------------------------
// User (identity owned by Auth0 — id is the Auth0 `sub` claim, synced on login)
// ---------------------------------------------------------------------------------

model User {
  id        String   @id
  name      String?
  email     String   @unique
  image     String?
  role      String?  @default("user")
  links     Link[]
  apiKeys   ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------------
// ApiKey (per-account public API credential — separate from the internal M2M channel)
// ---------------------------------------------------------------------------------

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyPrefix  String
  keyHash    String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}
