# Auth0 Configuration
# Run 'openssl rand -hex 32' to generate a secure AUTH0_SECRET
AUTH0_SECRET=__CHANGE_ME__
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000

# Database (local User table synced from Auth0 profile on login)
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public&sslmode=require"

# Backend Integration
# INTERNAL_API_URL: Private base URL for the Fastify server (used for server-side calls)
INTERNAL_API_URL=http://localhost:3001
INTERNAL_API_KEY=__CHANGE_ME__
