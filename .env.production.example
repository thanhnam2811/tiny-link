# Copy this to .env.production on the VPS (in the same directory as docker-compose.prod.yml)
# and fill in real values. This file is NOT committed with real secrets.
#
# IMPORTANT: do NOT wrap values in quotes - docker-compose's `env_file:` passes
# them through literally, including any quote characters, which breaks
# connection strings and other values.

# PostgreSQL (Neon, free tier)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis (Upstash, free tier - use the TCP/rediss:// connection string, not the REST URL)
REDIS_URL=rediss://default:password@host:port

# Client URL (for CORS and redirects)
CLIENT_URL=https://link.namtt.dev

# Admin Auth
ADMIN_PASSWORD=__CHANGE_ME__
JWT_SECRET=__CHANGE_ME__

# API Key (must match what the Vercel client/admin apps use for INTERNAL_API_KEY)
INTERNAL_API_KEY=__CHANGE_ME__

# Must match the Vercel project name for tiny-link-client (used to build allowed
# CORS origins for preview deployments, e.g. tiny-link-client-git-*.vercel.app)
VERCEL_PROJECT_NAME=tiny-link-client
